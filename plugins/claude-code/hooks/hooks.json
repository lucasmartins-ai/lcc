{
  "modules": ["./lcc-compact.mjs"],
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/lcc-pin.mjs\" precompact", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/lcc-pin.mjs\" startup", "timeout": 10 }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/lcc-pin.mjs\" sessionstart", "timeout": 10 }
        ]
      }
    ]
  }
}
