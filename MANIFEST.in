include AGENTS.md
include CHANGELOG.md
include CLAUDE.md
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include LICENSE
include README.md
include SECURITY.md
include pyproject.toml

recursive-include benchmarks *.md *.txt *.yaml
recursive-include act2_router *.py
recursive-include config *.yaml
recursive-include configs *.yaml
recursive-include docs *.md
recursive-include docker *
recursive-include examples *.md *.txt *.json
recursive-include eval .gitkeep
recursive-include tests *.py

recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * .DS_Store
