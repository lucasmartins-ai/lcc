---
import Outcome from "../../components/Outcome.astro";
import Base from "../../layouts/Base.astro";
import { currentStateIntro, statusDate, statusUrl, studies } from "../../lib/research.ts";
import { docFiles, docSlug, href, judge, lcc, read, short, title } from "../../lib/sources.ts";

const notes = docFiles
  .filter((f) => f.startsWith("docs/research/") || f.startsWith("benchmarks/research/"))
  .map((f) => ({ file: f, label: title(read(lcc, f), f), url: href(`${docSlug(f)}.html`) }));
---

<Base title="Research" current="Research" description="Pre-registered evaluations of the local models LCC ships, generated from the LCC-judge repo.">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">Research log</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">Every study, including the ones that failed</h1>
    <div class="mt-6 max-w-3xl space-y-4 text-dim">
      <p>
        The local models in LCC come out of <a class="text-accent underline" href={judge.url}>LCC-judge</a>. Each one is
        tested against a protocol committed before the run, and the results say what passed, what failed and what shipped. This page is built from that
        repo at <a class="font-mono text-accent underline" href={`${judge.url}/tree/${judge.sha}`}>{short(judge.sha)}</a>; nothing
        here is typed by hand. Only aggregates are published: session text stays on the maintainer's machine.
      </p>
      <div class="prose text-dim" set:html={currentStateIntro} />
    </div>

    <h2 class="mt-14 text-xl font-semibold">Studies</h2>
    <p class="mt-2 text-sm text-faint">
      Outcome and state come from the "Current state" table of <a class="underline hover:text-dim" href={statusUrl}>STATUS.md</a>{" "}
      ({statusDate}). Date: the commit that first added the protocol.
    </p>
    <div class="mt-6 overflow-hidden rounded-xl border border-line">
      <ul class="divide-y divide-line">
        {
          studies.map((s) => (
            <li>
              <a href={href(`research/${s.id}.html`)} class="grid grid-cols-1 gap-x-6 gap-y-2 p-4 hover:bg-panel sm:grid-cols-[9rem_minmax(0,1fr)_7rem] sm:items-baseline sm:p-5">
                <span class="font-mono text-xs text-faint">{s.registered.date}</span>
                <span>
                  <span class="font-medium text-ink">{s.name}</span>
                  <span class="mt-1 block text-sm text-dim [&_code]:font-mono [&_code]:text-[0.85em]" set:html={s.stateHtml} />
                </span>
                <span class="sm:text-right">
                  <Outcome outcome={s.outcome} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-10 md:grid-cols-2">
      <section>
        <h2 class="text-xl font-semibold">Roadmap</h2>
        <p class="mt-2 text-dim">
          What LCC-judge works on next, and the open gaps: <a class="text-accent underline" href={href("research/roadmap.html")}>roadmap</a>.
        </p>
      </section>
      <section>
        <h2 class="text-xl font-semibold">Notes in the lcc repo</h2>
        <ul class="mt-3 space-y-1.5 text-sm">
          {notes.map((n) => <li><a class="text-dim hover:text-accent" href={n.url}>{n.label}</a> <span class="font-mono text-xs text-faint">{n.file}</span></li>)}
        </ul>
      </section>
    </div>
  </div>
</Base>
